<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="BiblioFlow.Mobile.DetalleLibroPage"
             Title="Confirmar Reserva"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="20" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="TituloLabel" FontSize="20" FontAttributes="Bold" TextColor="#1E3A8A" />
                    <Label x:Name="AutorLabel" FontSize="14" TextColor="#64748B" />
                    <Label x:Name="IsbnLabel" FontSize="12" TextColor="#94A3B8" />

                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,5" />

                    <Label Text="📌 Ubicación Física en Biblioteca" FontSize="14" FontAttributes="Bold" TextColor="#0D9488" />
                    <Border BackgroundColor="#F0FDFA" Stroke="#99F6E4" StrokeShape="RoundRectangle 8" Padding="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="🗺️ " FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label x:Name="UbicacionEstanteLabel" FontSize="15" FontAttributes="Bold" TextColor="#0F766E" />
                                <Label Text="Sección de Consulta General - Planta Alta" FontSize="11" TextColor="#115E59" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="20" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Seleccionar Fecha y Hora de Recogida" FontSize="16" FontAttributes="Bold" TextColor="#1E3A8A" />

                    <Label Text="Fecha de Recogida:" FontSize="12" TextColor="#475569" />
                    <DatePicker x:Name="RecogidaDatePicker" Format="dd/MM/yyyy" MinimumDate="{x:Static sys:DateTime.Now}" />

                    <Label Text="Hora aproximada:" FontSize="12" TextColor="#475569" />
                    <TimePicker x:Name="RecogidaTimePicker" Time="10:00:00" />

                    <Button Text="✅ Confirmar Reserva" 
                            BackgroundColor="#16A34A" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="10" 
                            HeightRequest="48"
                            Margin="0,10,0,0"
                            Clicked="OnConfirmarReservaClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>