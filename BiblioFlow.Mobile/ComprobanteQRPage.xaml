<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiblioFlow.Mobile.ComprobanteQRPage"
             Title="Comprobante QR"
             BackgroundColor="#F8FAFC">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="20" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="¡Reserva Confirmada! 🎉" FontSize="18" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="Center" />
                    <Image x:Name="QrImageView" WidthRequest="200" HeightRequest="200" HorizontalOptions="Center" />
                    <Label x:Name="CodigoReservaLabel" FontSize="14" FontAttributes="Bold" TextColor="#1E3A8A" HorizontalOptions="Center" />
                    <Label x:Name="DetalleFechaHoraLabel" FontSize="12" TextColor="#475569" HorizontalOptions="Center" TextTransform="None" />
                </VerticalStackLayout>
            </Border>
            <Button Text="💾 Guardar Comprobante" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" Clicked="OnGuardarQRClicked" />
            <Button Text="🏠 Volver al Inicio" BackgroundColor="#1E3A8A" TextColor="White" CornerRadius="8" Clicked="OnVolverInicioClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>