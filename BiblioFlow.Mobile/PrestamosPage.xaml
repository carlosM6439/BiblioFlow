<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiblioFlow.Mobile.PrestamosPage"
             Title="V5. Mis Préstamos"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="Libros en Préstamo y Reservas" FontSize="20" FontAttributes="Bold" TextColor="#1E3A8A" />

            <CollectionView x:Name="PrestamosCollectionView">
                <CollectionView.EmptyView>
                    <Label Text="No tienes préstamos o reservas activas actualmente." TextColor="#64748B" HorizontalOptions="Center" Margin="0,30" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" Padding="15" StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#CBD5E1">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="#1E3A8A" />
                                    <Label Text="{Binding Autor}" FontSize="13" TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                    <Label Text="Activo" FontSize="11" TextColor="#166534" FontAttributes="Bold"/>
                                </Border>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10" ColumnDefinitions="*,*">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Ubicación Estante" FontSize="11" TextColor="#94A3B8" />
                                        <Label Text="{Binding UbicacionEstante}" FontSize="12" TextColor="#334155" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Fecha Vencimiento" FontSize="11" TextColor="#94A3B8" />
                                        <Label Text="{Binding FechaVencimiento}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- BOTONES DE RENOVACIÓN Y DEVOLUCIÓN -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
                                    <Button Grid.Column="0" 
                                            Text="🔄 Renovar" 
                                            BackgroundColor="#0D9488" 
                                            TextColor="White" 
                                            CornerRadius="8" 
                                            FontSize="12"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnRenovarClicked"/>

                                    <Button Grid.Column="1" 
                                            Text="🗑️ Devolver / Cancelar" 
                                            BackgroundColor="#DC2626" 
                                            TextColor="White" 
                                            CornerRadius="8" 
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDevolverReservaClicked"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>