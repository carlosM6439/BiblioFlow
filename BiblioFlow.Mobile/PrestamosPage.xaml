<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiblioFlow.Mobile.PrestamosPage"
             Title="Mis Préstamos Activos"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="Libros Actualmente prestados" FontSize="20" FontAttributes="Bold" TextColor="#1E3A8A" />
            <Label Text="Recuerda devolverlos antes de la fecha límite para evitar penalizaciones." FontSize="13" TextColor="#64748B" />

            <CollectionView x:Name="PrestamosCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" CornerRadius="12" BackgroundColor="White" HasShadow="True" BorderColor="#CBD5E1">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="#1E3A8A" />
                                    <Label Text="{Binding Autor}" FontSize="13" TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#DCFCE7" CornerRadius="6" Padding="6,2" HasShadow="False">
                                    <Label Text="En Curso" FontSize="11" TextColor="#166534" FontAttributes="Bold"/>
                                </Frame>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10" ColumnDefinitions="*,*">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Fecha Préstamo" FontSize="11" TextColor="#94A3B8" />
                                        <Label Text="{Binding FechaPrestamo}" FontSize="12" TextColor="#334155" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Fecha Vencimiento" FontSize="11" TextColor="#94A3B8" />
                                        <Label Text="{Binding FechaVencimiento}" FontSize="12" TextColor="#DC2626" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Grid.Row="2" Grid.ColumnSpan="2" 
                                        Text="🔄 Renovar Préstamo (+7 Días)" 
                                        BackgroundColor="#0D9488" 
                                        TextColor="White" 
                                        CornerRadius="6"
                                        FontSize="12"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnRenovarClicked"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>